        "enrollments_status_check": {
          "name": "enrollments_status_check",
          "value": "(\n                (\"enrollments\".\"status\" = 'enrolled' AND \"enrollments\".\"started_at\" IS NULL AND \"enrollments\".\"completed_at\" IS NULL)\n                OR (\"enrollments\".\"status\" = 'active' AND \"enrollments\".\"started_at\" IS NOT NULL AND \"enrollments\".\"completed_at\" IS NULL)\n                OR (\"enrollments\".\"status\" = 'completed' AND \"enrollments\".\"started_at\" IS NOT NULL AND \"enrollments\".\"completed_at\" IS NOT NULL)\n                OR (\"enrollments\".\"status\" = 'withdrawn' AND \"enrollments\".\"completed_at\" IS NULL)\n            )"
        },
        "enrollments_dates_check": {
          "name": "enrollments_dates_check",
          "value": "\"enrollments\".\"completed_at\" IS NULL OR \"enrollments\".\"started_at\" IS NULL OR \"enrollments\".\"completed_at\" >= \"enrollments\".\"started_at\""
        }
      }
