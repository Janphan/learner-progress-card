{
  "name": "learner-progress-card",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w learning-progress",
    "dev:server": "npm run dev -w @learner-progress/server",
    "build": "npm run build --workspaces --if-present",
